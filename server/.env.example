NODE_ENV=development

# Database matches the Postgres service in docker-compose.yml.
# Running the backend inside Docker? Compose overrides DB_HOST to "postgres".
# Running it on the host (make dev)? Leave DB_HOST as localhost.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tablab

# Auth must be at least 32 characters (enforced by env.config.ts).
# Generate with: openssl rand -hex 64
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Server
PORT=3000

# Frontend origin, used for CORS
FE_API=http://localhost:5173
